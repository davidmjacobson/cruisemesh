        }
      }
    },
    "%@ stops staying in step with your other devices now, and loses your family's Shore Pass mailbox as soon as this phone is online. The next time it is on the same Wi-Fi as one of them, it stops sending and receiving messages altogether and says it was removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stops staying in step with your other devices now, and loses your family's Shore Pass mailbox as soon as this phone is online. The next time it is on the same Wi-Fi as one of them, it stops sending and receiving messages altogether and says it was removed."
          }
        }
      }
    },
    "%@ stops staying in step with your other devices now. The next time it is on the same Wi-Fi as one of them, it stops sending and receiving messages altogether and says it was removed.": {
