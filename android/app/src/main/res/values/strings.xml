    <string name="ui_onboarding_welcome_eyebrow">Nearby-first messaging</string>
    <string name="ui_onboarding_welcome_title">Messages that find a way through</string>
    <string name="ui_onboarding_welcome_body">CruiseMesh gets your messages to friends and family using virtually every connection your phone has — Bluetooth, local Wi-Fi, and even handing them phone to phone when there\'s no signal at all.</string>
    <string name="ui_onboarding_welcome_support">Built for cruises, hikes, festivals, stadiums, road trips — anywhere the network is weak, missing, or overloaded.</string>
    <string name="ui_onboarding_delivery_eyebrow">How it works</string>
    <string name="ui_onboarding_delivery_title">It uses whatever\'s around</string>
    <!-- The internet clause is deliberately qualified: internet delivery
         needs a Cruise Pass or a self-hosted relay, and onboarding must not
         imply the free tier includes it. -->
    <string name="ui_onboarding_delivery_body">Nearby, CruiseMesh talks phone-to-phone over Bluetooth and local Wi-Fi. Farther away, your message hops between other phones running CruiseMesh until it reaches your friend — and, with a Cruise Pass or your own server, over the internet whenever any of those phones has a connection.</string>
    <string name="ui_onboarding_private_title">Private by default</string>
    <string name="ui_onboarding_private_detail">Every message is encrypted end to end, so the phones and networks that help carry it can never read it.</string>
    <string name="ui_onboarding_permissions_eyebrow">Turn on a few permissions</string>
    <string name="ui_onboarding_permissions_title">Give CruiseMesh more ways to connect</string>
    <string name="ui_onboarding_permissions_body">Each of these opens up another path for your messages.</string>
    <string name="ui_onboarding_permission_nearby_title">Nearby devices and notifications</string>
    <string name="ui_onboarding_permission_nearby_detail">Lets your phone hand messages directly to phones around you, and tells you the moment one arrives.</string>
    <string name="ui_onboarding_permission_background_title">Background activity</string>
    <string name="ui_onboarding_permission_background_detail">Keeps the mesh working while your phone is in your pocket, so messages still move when the screen is off.</string>
    <string name="ui_onboarding_wifi_eyebrow">Local Wi-Fi</string>
    <string name="ui_onboarding_wifi_title">Leave Wi-Fi on, even with no internet</string>
    <string name="ui_onboarding_wifi_body">On a ship or anywhere the Wi-Fi has no internet, keep it connected anyway — CruiseMesh uses that local network to reach phones near you faster than Bluetooth alone.</string>
    <string name="ui_onboarding_wifi_support_title">It costs you nothing</string>
    <string name="ui_onboarding_wifi_support_detail">CruiseMesh won\'t use the dead connection for the internet; it just uses it to find and talk to nearby phones.</string>
    <string name="ui_onboarding_profile_eyebrow">Your profile</string>
