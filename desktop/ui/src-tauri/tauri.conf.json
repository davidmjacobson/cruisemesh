{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CruiseMesh",
  "version": "0.2.0",
  "identifier": "app.cruisemesh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CruiseMesh",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "windows": { "webviewInstallMode": { "type": "skip" } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["cruisemesh"] } }
  }
}
